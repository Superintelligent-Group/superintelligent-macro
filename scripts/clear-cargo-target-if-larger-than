#!/usr/bin/env bash

set -euo pipefail

if [[ $# -lt 2 || $# -gt 3 ]]; then
  echo "usage: $0 <TARGET_DIR> <MAX_SIZE_GB> [SMALL_CLEAN_SIZE_GB]" >&2
  exit 1
fi

target_dir="$1"
max_size_gb="$2"
small_clean_size_gb="${3:-}"

if [[ ! -d "$target_dir" ]]; then
  echo "$target_dir does not exist yet"
  exit 0
fi

if [[ -n "$small_clean_size_gb" && "$small_clean_size_gb" -ge "$max_size_gb" ]]; then
  echo "small clean threshold (${small_clean_size_gb}gb) must be smaller than max size (${max_size_gb}gb)" >&2
  exit 1
fi

current_size_kb=$(du -sk "$target_dir" | cut -f1)
current_size_gb=$(( current_size_kb / 1024 / 1024 ))

echo "$target_dir size: ${current_size_gb}gb (max: ${max_size_gb}gb)"

if [[ "$current_size_gb" -gt "$max_size_gb" ]]; then
  echo "clearing $target_dir"
  find "$target_dir" -mindepth 1 -maxdepth 1 -exec rm -rf {} +
elif [[ -n "$small_clean_size_gb" && "$current_size_gb" -gt "$small_clean_size_gb" ]]; then
  echo "running cargo clean --workspace (size above ${small_clean_size_gb}gb)"
  cargo clean --workspace --manifest-path rust/cloud-storage/Cargo.toml
fi
